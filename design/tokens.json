{
  "$schema": "https://design-tokens.org/schema.json",
  "primitive": {
    "color": {
      "night": {
        "950": { "$value": "#10131A", "$type": "color" },
        "900": { "$value": "#171B24", "$type": "color" },
        "800": { "$value": "#242A38", "$type": "color" },
        "700": { "$value": "#38404F", "$type": "color" }
      },
      "sand": {
        "100": { "$value": "#F5F0E6", "$type": "color" },
        "300": { "$value": "#DCD3BE", "$type": "color" },
        "500": { "$value": "#9C9384", "$type": "color" }
      },
      "copper": {
        "400": { "$value": "#D99A5C", "$type": "color" },
        "500": { "$value": "#B0713A", "$type": "color" },
        "700": { "$value": "#7A4C24", "$type": "color" },
        "900": { "$value": "#33200E", "$type": "color" }
      }
    },
    "font": {
      "display": { "$value": "var(--font-eb-garamond), 'EB Garamond', Georgia, serif", "$type": "fontFamily" },
      "sans": { "$value": "var(--font-jakarta), 'Plus Jakarta Sans', system-ui, sans-serif", "$type": "fontFamily" }
    },
    "motion": {
      "duration": {
        "micro": { "$value": "180ms", "$type": "duration" },
        "base": { "$value": "320ms", "$type": "duration" },
        "reveal": { "$value": "1.1s", "$type": "duration" },
        "cine": { "$value": "1.8s", "$type": "duration" }
      },
      "ease": {
        "out-expo": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubicBezier" },
        "cine": { "$value": "cubic-bezier(0.65, 0, 0.35, 1)", "$type": "cubicBezier" }
      }
    },
    "tracking": {
      "display": { "$value": "-0.01em", "$type": "dimension" },
      "label": { "$value": "0.28em", "$type": "dimension" }
    }
  },
  "semantic": {
    "background": { "$value": "{primitive.color.night.950}", "$type": "color" },
    "foreground": { "$value": "{primitive.color.sand.100}", "$type": "color" },
    "card": { "$value": "{primitive.color.night.900}", "$type": "color" },
    "card-foreground": { "$value": "{primitive.color.sand.100}", "$type": "color" },
    "muted": { "$value": "{primitive.color.night.900}", "$type": "color" },
    "muted-foreground": { "$value": "{primitive.color.sand.500}", "$type": "color" },
    "accent": { "$value": "{primitive.color.night.800}", "$type": "color" },
    "accent-foreground": { "$value": "{primitive.color.sand.100}", "$type": "color" },
    "border": { "$value": "{primitive.color.night.700}", "$type": "color" },
    "ring": { "$value": "{primitive.color.copper.400}", "$type": "color" },
    "radius": { "$value": "0.85rem", "$type": "dimension" },
    "gold": { "$value": "{primitive.color.copper.400}", "$type": "color" },
    "gold-dim": { "$value": "{primitive.color.copper.900}", "$type": "color" },
    "surface-line": { "$value": "{primitive.color.night.700}", "$type": "color" },
    "type-display": { "$value": "{primitive.font.display}", "$type": "fontFamily" },
    "type-body": { "$value": "{primitive.font.sans}", "$type": "fontFamily" },
    "ease-reveal": { "$value": "{primitive.motion.ease.out-expo}", "$type": "cubicBezier" },
    "ease-cine": { "$value": "{primitive.motion.ease.cine}", "$type": "cubicBezier" },
    "duration-micro": { "$value": "{primitive.motion.duration.micro}", "$type": "duration" },
    "duration-base": { "$value": "{primitive.motion.duration.base}", "$type": "duration" },
    "duration-reveal": { "$value": "{primitive.motion.duration.reveal}", "$type": "duration" },
    "tracking-display": { "$value": "{primitive.tracking.display}", "$type": "dimension" },
    "tracking-label": { "$value": "{primitive.tracking.label}", "$type": "dimension" }
  },
  "component": {
    "hero": {
      "title-size": { "$value": "clamp(2.8rem, 7.4vw, 6.2rem)", "$type": "dimension" },
      "title-leading": { "$value": "1.02", "$type": "number" },
      "glow": {
        "$value": "radial-gradient(ellipse 70% 50% at 50% 100%, rgba(217, 154, 92, 0.20), rgba(51, 32, 14, 0.12) 45%, transparent 72%)",
        "$type": "gradient"
      },
      "vignette": {
        "$value": "linear-gradient(to top, rgba(16, 19, 26, 0.96) 0%, rgba(16, 19, 26, 0.32) 42%, rgba(16, 19, 26, 0.58) 100%)",
        "$type": "gradient"
      }
    },
    "button": {
      "primary-bg": { "$value": "{primitive.color.copper.400}", "$type": "color" },
      "primary-fg": { "$value": "{primitive.color.night.950}", "$type": "color" },
      "primary-hover-bg": { "$value": "{primitive.color.sand.100}", "$type": "color" },
      "ghost-border": { "$value": "rgba(245, 240, 230, 0.35)", "$type": "color" },
      "ghost-hover-border": { "$value": "{primitive.color.copper.400}", "$type": "color" }
    }
  }
}
